# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_USER=leadqualifier
POSTGRES_DB=leadqualifier
N8N_DB=n8n

# n8n editor login (http://localhost:5678)
N8N_USER=admin
N8N_PASSWORD=change-me-n8n
# Any long random string; keep it — losing it orphans stored credentials.
N8N_ENCRYPTION_KEY=change-me-32-char-minimum-encryption-key

# Signed approval links for the human-in-the-loop gate.
APPROVAL_SECRET=change-me-approval-secret

# LLM for scoring. Demo default: ollama (local, $0).
LLM_PROVIDER=ollama
SCORING_MODEL=llama3.2:3b
# Client deployments (client pays their own key):
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Public URL of the companion (used in approve/reject links).
PUBLIC_BASE_URL=http://localhost:5000
# Optional: forward notifications to a real Slack incoming webhook.
SLACK_WEBHOOK_URL=
# Optional: public n8n URL if webhooks must be reachable from outside.
N8N_WEBHOOK_URL=
